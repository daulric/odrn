{
  "name": "odrn",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "bun --bun run expo start",
    "reset-project": "bun --bun run ./scripts/reset-project.js",
    "android": "bun --bun run expo run:android",
    "ios": "bun --bun run expo run:ios",
    "web": "bun --bun run expo start --web",
    "lint": "bun --bun run expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "bun --bun run expo-doctor",
    "prebuild:android": "bun --bun run expo prebuild --platform android --clean",
    "prebuild:ios": "bun --bun run expo prebuild --platform ios --clean"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/config": "^1.1.20",
    "@gluestack-ui/themed": "^1.1.73",
    "@preact/signals-react": "^3.6.1",
    "@preact/signals-react-transform": "^0.6.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.89.0",
    "@types/crypto-js": "^4.2.2",
    "base64-arraybuffer": "^1.0.2",
    "crypto-js": "^4.2.0",
    "expo": "~54.0.30",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.10",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.8",
    "expo-image": "~55.0.5",
    "expo-image-manipulator": "^55.0.9",
    "expo-image-picker": "^55.0.10",
    "expo-linear-gradient": "~55.0.8",
    "expo-linking": "~55.0.7",
    "expo-notifications": "~55.0.10",
    "expo-router": "~55.0.3",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-updates": "~55.0.12",
    "expo-web-browser": "~55.0.9",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.83.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-incall-manager": "^4.0.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.19.0",
    "react-native-svg": "15.15.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.2",
    "react-native-webrtc": "^124.0.7",
    "react-native-worklets": "0.7.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-incall-manager",
          "react-native-webrtc"
        ]
